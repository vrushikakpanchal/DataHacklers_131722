# ==============================================================================
# NTRO Gen AI Platform for Automated Content Transformation (SIH PS 26154)
# Environment Configuration Template
# ==============================================================================

# Local Sovereign LLM (Ollama) Settings
OLLAMA_API_URL="http://localhost:11434/api/generate"
OLLAMA_TAGS_URL="http://localhost:11434/api/tags"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT_SECONDS=180

# Application Server Configuration
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="production"

# Ingestion & Upload Boundaries
MAX_UPLOAD_SIZE_MB=100
ENABLE_PII_REDACTION=true

# Storage Paths (relative to repository root)
UPLOAD_DIR="data/sample_inputs"
OUTPUT_DIR="data/outputs"
TEMP_DIR="temp_uploads"
