# Python environments and caches
/venv/
/.venv/
**/venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets and editor / OS files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.idea/
.vscode/

# Uploaded files are temporary runtime data; keep directory structure
/temp_uploads/*
!/temp_uploads/.gitkeep
/my_code/temp_uploads/*
!/my_code/temp_uploads/.gitkeep

# Generated output artifacts; retain directory placeholders
/data/outputs/**
!/data/outputs/.gitkeep
/output/**
!/output/.gitkeep
/video_scenes/**
!/video_scenes/.gitkeep
/my_code/data/outputs/**
!/my_code/data/outputs/.gitkeep
/my_code/output/**
!/my_code/output/.gitkeep

# Standalone team prototypes not needed in core backend
/tanvi_code/
/sanika_code/

# Active module dependencies required by adapters
/pallavi_code/*
!/pallavi_code/generator.py
!/pallavi_code/validator.py

# Integrated dataset and threat-intel files
/ishita_code/*
!/ishita_code/backend/
!/ishita_code/datasets/
/ishita_code/backend/*
!/ishita_code/backend/data/
/ishita_code/backend/data/*
!/ishita_code/backend/data/threat_intel_store.json
/ishita_code/datasets/*
!/ishita_code/datasets/*.pdf
!/ishita_code/datasets/*known_exploited*.csv

# Streamlit local state
.streamlit/secrets.toml
.aider*
