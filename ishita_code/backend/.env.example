# SENTINEL Backend Environment Configuration

# Project & API
PROJECT_NAME="SENTINEL Cybersecurity Content Intelligence"
API_V1_STR="/api"
SECRET_KEY="sentinel-super-secret-key-change-in-production-2026-sih"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: SQLite WAL mode in data/sentinel.db, or PostgreSQL)
# Example PostgreSQL: postgresql://user:password@localhost:5432/sentinel
DATABASE_URL="sqlite:///data/sentinel.db"

# Ollama Instance (Default local endpoint)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gpt-oss:120b-cloud"
OLLAMA_TIMEOUT_SECONDS=180.0
OLLAMA_MAX_RETRIES=2

# File Upload Limits (in bytes, default: 100MB)
MAX_UPLOAD_SIZE_BYTES=104857600
